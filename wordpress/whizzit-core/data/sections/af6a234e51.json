{"id":"af6a234e51","title":"Hero (About hero)","template":"<section class=\"hero hero--sky about-hero\" aria-labelledby=\"about-hero-title\">\n  <div class=\"container about-hero__inner\">\n    <nav class=\"breadcrumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"{{u0}}\">{{s1}}</a></li><li><span aria-current=\"page\">{{s2}}</span></li></ol></nav>\n    <p class=\"eyebrow\">{{s3}}</p>\n    \n    <h1 class=\"about-hero__title\" id=\"about-hero-title\">\n      <span class=\"about-hero__line\">{{s4}}</span>\n      <span class=\"about-hero__line\"><span class=\"about-hero__plate\">{{s5}}</span></span>\n    </h1>\n    <p class=\"about-hero__lead\">{{s6}}</p>\n    \n<div class=\"callback\">\n  <form class=\"callback__form\" action=\"/api/submit.php\" method=\"post\" data-validate data-success=\"callback-success\" aria-labelledby=\"callback-title\">\n    <input type=\"hidden\" name=\"form_name\" value=\"callback\">\n    <input class=\"visually-hidden\" type=\"checkbox\" name=\"botcheck\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">\n    <p class=\"callback__head\"><strong id=\"callback-title\">Request a callback</strong><span>We respond the same working day.</span></p>\n    <div class=\"callback__row\">\n      \n  <div class=\"field\">\n    <label class=\"field__label\" for=\"cb-name\">Name</label>\n    \n    <input class=\"field__input\" id=\"cb-name\" name=\"name\" type=\"text\" autocomplete=\"name\" placeholder=\"Jane Smith\" required aria-describedby=\"cb-name-error\">\n    <p class=\"field__error\" id=\"cb-name-error\"></p>\n  </div>\n      \n  <div class=\"field\">\n    <label class=\"field__label\" for=\"cb-email\">Email</label>\n    \n    <input class=\"field__input\" id=\"cb-email\" name=\"email\" type=\"email\" autocomplete=\"email\" placeholder=\"jane@company.co.uk\" required aria-describedby=\"cb-email-error\">\n    <p class=\"field__error\" id=\"cb-email-error\"></p>\n  </div>\n      \n      <div class=\"field callback__message\">\n        <label class=\"field__label\" for=\"cb-message\">How can we help? <span class=\"field__optional\">(optional)</span></label>\n        <textarea class=\"field__input\" id=\"cb-message\" name=\"message\" rows=\"1\" placeholder=\"A quick note about your IT…\" aria-describedby=\"cb-message-error\"></textarea>\n        <p class=\"field__error\" id=\"cb-message-error\"></p>\n      </div>\n      <button class=\"btn btn--primary callback__submit\" type=\"submit\" data-track=\"about-hero-submit\"><span>Request a callback</span></button>\n    </div>\n    <div class=\"captcha-row\"><div class=\"g-recaptcha\" data-sitekey=\"6LetGGItAAAAABGoBmlvEaWqFhJNfk97jeH2zaOv\" data-theme=\"dark\"></div><p class=\"field__error\">Please complete the reCAPTCHA to continue.</p></div>\n    <p class=\"form-error\" role=\"alert\" hidden>Sorry, something went wrong. Please call 020 4634 2518 or email info@whizzit.co.uk.</p>\n  </form>\n  <div class=\"callback__success\" id=\"callback-success\" tabindex=\"-1\" hidden>\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8.5 12 2.5 2.5 4.5-5\"/></svg>\n    <p><strong>{{s7}}</strong> {{s8}} <a href=\"{{u9}}\" data-track=\"about-hero-success-phone\">{{s10}}</a></p>\n  </div>\n</div>\n    <p class=\"hero-sky__note\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z\"/></svg><span>{{s11}} <a href=\"{{u12}}\" data-track=\"about-hero-phone\">{{s13}}</a> {{s14}}</span></p>\n  </div>\n</section>","uses":1,"slots