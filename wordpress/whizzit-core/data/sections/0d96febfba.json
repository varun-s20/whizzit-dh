{"id":"0d96febfba","title":"Lx place","template":"<section class=\"section lx-place\" aria-labelledby=\"wales-place-title\">\n  <div class=\"container lx-place__grid\">\n    <div class=\"lx-place__media\">\n      <figure class=\"media ratio-4-5 lx-place__photo\">\n    {{i0}}\n  </figure>\n      <p class=\"lx-place__tag\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M20 10c0 5-8 12-8 12s-8-7-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg><span>{{s1}}</span></p>\n    </div>\n    <div class=\"lx-place__copy\">\n      <h2 class=\"grad-head\" id=\"wales-place-title\">{{s2}}</h2>\n      <p class=\"lx-place__lede\">{{s3}}</p><p class=\"\">{{s4}}</p>\n      \n    </div>\n  </div>\n</section>","uses":1,"slots":[{"k":"i0","type":"i","label":"Image 1","default":{"html":"<picture>\n      <source type=\"image/avif\" srcset=\"{{ASSETS}}/images/photos/whizzit-office-desks-480.avif 480w, {{ASSETS}}/images/photos/whizzit-office-desks-768.avif 768w, {{ASSETS}}/images/photos/whizzit-office-desks-1024.avif 1024w, {{ASSETS}}/images/photos/whizzit-office-desks-1280.avif 1280w\" sizes=\"(min-width: 1024px) 40vw, 100vw\">\n      <source type=\"image/webp\" srcset=\"{{ASSETS}}/images/photos/whizzit-office-desks-480.webp 480w, {{ASSETS}}/images/photos/whizzit-office-desks-768.webp 768w, {{ASSETS}}/images/photos/whizzit-office-desks-1024.webp 1024w, {{ASSETS}}/images/photos/whizzit-office-desks-1280.webp 1280w\" sizes=\"(min-width: 1024px) 40vw, 100vw\">\n      <img src=\"{{ASSETS}}/images/photos/whizzit-office-desks-1280.webp\" alt=\"The WhizzIT office with engineers working at their desks\" width=\"1280\" height=\"720\" loading=\"lazy\" decoding=\"async\">\n    </picture>","src":"{{ASSETS}}/images/photos/whizzit-office-desks-1280.webp"}},{"k":"s1","type":"s","label":"Paragraph 1","default":"Covering Wales"},{"k":"s2","type":"s","label":"Heading 1","default":"Managed IT for businesses across Wales"},{"k":"s3","type":"s","label":"Paragraph 2","default":"Wales spreads a lot of business activity across a wide geography, from the M4 corridor to sites where the nearest town is a drive away. Connectivity and remote working therefore matter more here than in a dense city centre, and manufacturing and public-sector-adjacent work make up a healthy share of the mix."},{"k":"s4","type":"s","label":"Paragraph 3","default":"Support built around remote-first working suits that well. Our service desk resolves most issues remotely, usually the same working day, and where a site genuinely needs an engineer, one travels to you with a same-working-day aim."}]}