nel-email-security-services-2-2\" aria-labelledby=\"tab-email-security-services-2-2\" tabindex=\"0\" hidden><p class=\"sv-tabpanel__n\">{{s21}}</p><p>{{s22}}</p></div><div class=\"tabs__panel sv-tabpanel__panel\" role=\"tabpanel\" id=\"panel-email-security-services-2-3\" aria-labelledby=\"tab-email-security-services-2-3\" tabindex=\"0\" hidden><p class=\"sv-tabpanel__n\">{{s23}}</p><p>{{s24}}</p></div><div class=\"tabs__panel sv-tabpanel__panel\" role=\"tabpanel\" id=\"panel-email-security-services-2-4\" aria-labelledby=\"tab-email-security-services-2-4\" tabindex=\"0\" hidden><p class=\"sv-tabpanel__n\">{{s25}}</p><p>{{s26}}</p></div>\n    </div>\n  </div>\n</section>","uses":1,"slots":[{"k":"s0","type":"s","label":"Label above heading 1","default":"How attacks work now"},{"k":"s1","type":"s","label":"Heading 1","default":"Phishing does not look like phishing any more"},{"k":"s2","type":"s","label":"Paragraph 1","default":"The training example everyone remembers is a badly spelled email from a stranger with an obvious link. Almost nothing looks like that now."},{"k":"s3","type":"s","label":"Paragraph 2","default":"Layers we put in place"},{"k":"s4","type":"s","label":"List item 1","default":"Advanced anti-phishing and anti-spam filtering"},{"k":"s5","type":"s","label":"List item 2","default":"Attachment scanning and link rewriting"},{"k":"s6","type":"s","label":"List item 3","default":"Impersonation protection for named people"},{"k":"s7","type":"s","label":"List item 4","default":"SPF, DKIM and DMARC configured and enforced"},{"k":"s8","type":"s","label":"List item 5","default":"Mailbox rule and forwarding alerts"},{"k":"s9","type":"s","label":"List item 6","default":"Awareness training so people know what to check"},{"k":"u10","type":"u","label":"Link: Security awareness training","default":"/cyber-security/security-awareness-training-services/"},{"k":"s11","type":"s","label":"Link text 1","default":"Security awareness training"},{"k":"s12","type":"s","label":"Button 1","default":"Trusted services"},{"k":"s13","type":"s","label":"Button 2","default":"QR codes"},{"k":"s14","type":"s","label":"Button 3","default":"Thread hijacking"},{"k":"s15","type":"s","label":"Button 4","default":"MFA interception"},{"k":"s16","type":"s","label":"Button 5","default":"Where filtering stops"},{"k":"s17","type":"s","label":"Paragraph 3","default":"01 / 05"},{"k":"s18","type":"s","label":"Paragraph 4","default":"A genuine SharePoint or Dropbox share notification, sent from the real platform, pointing at a document that happens to be malicious. Because the notification really did come from the platform, it passes every check a filter can reasonably make."},{"k":"s19","type":"s","label":"Paragraph 5","default":"02 / 05"},{"k":"s20","type":"s","label":"Paragraph 6","default":"A QR code in an attachment, because it moves the attack onto a phone where there is no filtering and no visible address bar. The message itself carries no link for anything to inspect."},{"k":"s21","type":"s","label":"Paragraph 7","default":"03 / 05"},{"k":"s22","type":"s","label":"Paragraph 8","default":"A reply inserted into an email thread that has been running for weeks, from a supplier whose mailbox was compromised last month, so it has real history above it. Nothing about the conversation looks new or unusual."},{"k":"s23","type":"s","label":"Paragraph 9","default":"04 / 05"},{"k":"s24","type":"s","label":"Paragraph 10","default":"The one that catches the most people. An attacker with a stolen password sits between you and Microsoft using a proxy page that looks exactly right. You type the code, and they capture the session token rather than the password. Multi-factor authentication still matters enormously, but on its own it is not the finish line people assume."},{"k":"s25","type":"s","label":"Paragraph 11","default":"05 / 05"},{"k":"s26","type":"s","label":"Paragraph 12","default":"Filtering deals with volume. What it will not do is make a convincing message from a real supplier account look wrong, which is why authentication, monitoring and a team that knows to check unusual requests all sit alongside it."}]}